# Copie ce fichier en .env et adapte l'adresse.
#
# "localhost" ne fonctionne PAS depuis un téléphone physique (Expo Go) : mets
# l'adresse IP locale de ton PC sur le même Wi-Fi que le téléphone (celle que
# `ipconfig` donne pour "Adresse IPv4"), et démarre l'API avec
# `python manage.py runserver 0.0.0.0:8000` côté backend.
#
# - Téléphone physique (Expo Go) : IP locale du PC   -> http://192.168.1.141:8000/api
# - Émulateur Android                                -> http://10.0.2.2:8000/api
# - Simulateur iOS / navigateur (expo start --web)   -> http://localhost:8000/api
EXPO_PUBLIC_API_URL=http://192.168.1.141:8000/api
