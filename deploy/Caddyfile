# Un seul domaine : l'app web à la racine, l'app téléphone (PWA) sous /app/,
# l'API sous /api, l'administration sous /admin/ (ou BENEF_ADMIN_PATH).
# Le certificat HTTPS est obtenu et renouvelé automatiquement.
{$BENEF_DOMAIN} {
	encode gzip zstd

	@backend path /api/* /{$BENEF_ADMIN_PATH:admin}/* /api-auth/* /static/*
	handle @backend {
		reverse_proxy backend:8000
	}

	handle_path /media/* {
		root * /srv/media
		file_server
	}

	# App téléphone installable (iPhone : Safari → Partager → « Sur l'écran d'accueil »).
	redir /app /app/ 308
	handle /app/* {
		root * /srv/mobile
		# Le service worker ne doit jamais rester en cache : sinon une mise à
		# jour de l'app mettrait des jours à arriver.
		@sw path /app/sw.js
		header @sw Cache-Control "no-cache"
		# Fichiers dont le nom change à chaque version : gardés un an par le
		# navigateur, sans revérifier (chaque vérification coûte un aller-retour,
		# près d'une demi-seconde depuis la Guinée).
		@appfiles path /app/_expo/* /app/assets/*
		header @appfiles Cache-Control "public, max-age=31536000, immutable"
		@apppage not path /app/_expo/* /app/assets/* /app/sw.js
		header @apppage Cache-Control "no-cache"
		try_files {path} /app/index.html
		file_server
	}

	handle {
		root * /srv/web
		@webfiles path /assets/*
		header @webfiles Cache-Control "public, max-age=31536000, immutable"
		# La page elle-même est toujours revérifiée : une mise à jour arrive tout de suite.
		@webpage not path /assets/*
		header @webpage Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# www.<domaine> -> <domaine> (même certificat automatique).
www.{$BENEF_DOMAIN} {
	redir https://{$BENEF_DOMAIN}{uri} permanent
}

# SolFerme (projet séparé : /root/SolFerme/deploy sur le serveur). Son API
# rejoint ce Caddy par le réseau Docker « deploy_default » (alias solferme-backend).
# Si SolFerme est arrêté, seul ce domaine répond 502 : Bénef n'est pas touché.
solferme.monbenef.com {
	encode gzip zstd
	reverse_proxy solferme-backend:8000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
