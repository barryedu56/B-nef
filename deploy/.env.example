# Copie en deploy/.env puis remplis. Ne jamais committer deploy/.env.

# Domaine qui pointe vers ce serveur (enregistrement DNS A), ex. app.benef.gn
BENEF_DOMAIN=

# Clé secrète Django : longue et aléatoire, ex. généré avec
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_TIME_ZONE=Africa/Conakry

# Base PostgreSQL (créée automatiquement au premier démarrage)
DB_NAME=benef
DB_USER=benef
# Mot de passe long et aléatoire (même commande que ci-dessus)
DB_PASSWORD=
BACKUP_KEEP_DAYS=14

DEFAULT_BASE_CURRENCY=GNF
EXCHANGE_RATE_MAX_AGE_HOURS=36

# E-mails (mot de passe oublié) : compte SMTP (Brevo, Mailjet, Gmail…)
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Alertes d'erreurs serveur (optionnel, sentry.io)
SENTRY_DSN=
GUNICORN_WORKERS=3
