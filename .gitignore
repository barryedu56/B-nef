# Chaque sous-projet (backend/mobile/web) a déjà son propre .gitignore —
# celui-ci est une sécurité supplémentaire au niveau racine (dossiers non
# couverts comme design/, fichiers qui traîneraient à la racine).

# Secrets — jamais commités, seuls les .env.example le sont
.env
.env.local
.env.*.local

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/

# Builds / exports
dist/
build/
.expo/
staticfiles/
media/

# OS / éditeurs
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
