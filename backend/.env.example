# Copie ce fichier en .env et adapte les valeurs.

DJANGO_SECRET_KEY=change-moi-en-quelque-chose-de-long-et-aleatoire
DJANGO_DEBUG=True
# "*" = pratique en dev pour que le téléphone (Expo) atteigne l'API via l'IP
# locale du PC (change selon le réseau). À restreindre en production.
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Africa/Conakry

# --- Base de données ---
# Démarrage rapide sans MySQL :
#   DB_ENGINE=sqlite
# Avec WAMP (MySQL) : crée d'abord la base "gestion_finance" (phpMyAdmin),
# puis :
DB_ENGINE=mysql
DB_NAME=gestion_finance
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Devises ---
DEFAULT_BASE_CURRENCY=GNF
EXCHANGE_RATE_MAX_AGE_HOURS=36

# --- CORS (front) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# --- E-mail (mot de passe oublié) ---
# Laisse EMAIL_HOST vide en dev : les e-mails s'affichent dans la console
# `runserver` au lieu d'être envoyés. Pour un vrai envoi, renseigne un compte
# SMTP (ex. Gmail avec un "mot de passe d'application", Brevo, Mailjet...).
DEFAULT_FROM_EMAIL=no-reply@gestion-finance.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Prod uniquement (sans effet tant que DJANGO_DEBUG=True) ---
# Domaine(s) réels une fois déployé (remplace ALLOWED_HOSTS=* ci-dessus par
# ex. "monapp.com,api.monapp.com") + origine(s) exactes du front pour que le
# navigateur accepte les requêtes POST/PATCH protégées CSRF (session admin).
# DJANGO_CSRF_TRUSTED_ORIGINS=https://monapp.com
# Mets à False seulement si un proxy/reverse-proxy gère déjà la redirection
# HTTPS lui-même (sinon laisse la valeur par défaut : True).
# DJANGO_SECURE_SSL_REDIRECT=True
# Suivi d'erreurs en temps réel (sentry.io, gratuit pour un petit projet) —
# laisse vide pour désactiver, l'app fonctionne normalement sans.
# SENTRY_DSN=
